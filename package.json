{
  "name": "eleventy-plugin-broken-links",
  "version": "2.2.1",
  "description": "An Eleventy plugin to check for broken external links",
  "homepage": "https://github.com/bradleyburgess/eleventy-plugin-broken-links",
  "main": ".eleventy.js",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "bump": "npm --no-git-tag-version version",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradleyburgess/eleventy-plugin-broken-links.git"
  },
  "keywords": [
    "11ty",
    "11ty-plugin",
    "eleventy",
    "eleventy-plugin",
    "broken-links"
  ],
  "author": {
    "name": "Bradley Burgess",
    "url": "https://github.com/bradleyburgess"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bradleyburgess/eleventy-plugin-broken-links/issues"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@types/jest": "^30.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nyc": "^18.0.0",
    "prettier": "^3.8.4"
  },
  "dependencies": {
    "@11ty/eleventy-fetch": "^5.1.2",
    "debug": "^4.4.3",
    "kleur": "^4.1.5",
    "minimatch": "^10.2.5",
    "node-html-parser": "^5.4.2",
    "valid-url": "^1.0.9"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.js"
    ]
  }
}
